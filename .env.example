# MongoDB Atlas Connection String
# Replace with your actual connection string from MongoDB Atlas
MONGODB_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/safepay?retryWrites=true&w=majority

# --- Keys for Vercel deployment (base64-encoded) ---
# These are only needed when deploying to Vercel (read-only filesystem).
# Locally, the app reads from aes_key.bin, search_key.bin, paillier_priv.json files.
#
# Generate with: cat aes_key.bin | base64
AES_KEY_B64=
# Generate with: cat search_key.bin | base64
SEARCH_KEY_B64=
# Paste the full JSON content of paillier_pub.json
PAILLIER_PUB_JSON=
# Paste the full JSON content of paillier_priv.json
PAILLIER_PRIV_JSON=
